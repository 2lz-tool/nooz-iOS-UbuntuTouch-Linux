    <string name="tour_loom_name">El Telar</string>
    <string name="tour_loom_body">Lo que tus fuentes te enviaron realmente, tejido contra lo que de verdad leíste. Tira hacia abajo en tu quiosco, o toca la barra de colores sobre las noticias.</string>
    <string name="tour_flash_name">Nooz Flash</string>
    <string name="tour_flash_body">Los titulares del día reducidos a una línea cada uno, con una vía de vuelta al artículo completo. Apagado hasta que lo actives, en Ajustes.</string>
    <string name="tour_cast_name">Nooz Cast</string>
    <string name="tour_cast_body">Un artículo leído en voz alta por una voz que se ejecuta en tu teléfono, no en un servidor. También en Ajustes; pregunta antes de descargar nada.</string>
    <string name="tour_clippings_name">Recortes</string>
    <string name="tour_clippings_body">Toca el marcador mientras lees para guardar un texto. Recortes los conserva como trozos arrancados del periódico.</string>
    <string name="tour_history_name">Hoy en la historia</string>
