    <string name="onboarding_mode_explainer">“Hiện các nút” giữ nút quay lại và thanh tiện ích luôn thấy rõ. “Toàn trang” ẩn chúng đi để trang thật trơ trụi; vuốt sang phải để quay lại. Bạn có thể đổi bất cứ lúc nào trong Cài đặt.</string>
    <string name="tour_title">Bên trong có gì</string>
    <string name="tour_loom_name">Khung cửi</string>
    <string name="tour_loom_body">Những gì nguồn của bạn thực sự đã gửi, dệt cùng với những gì bạn thực sự đã đọc. Kéo xuống trên sạp báo, hoặc chạm vào thanh màu phía trên các tin.</string>
    <string name="tour_flash_name">Nooz Flash</string>
    <string name="tour_flash_body">Các tựa đề trong ngày rút gọn còn một dòng mỗi tin, kèm lối quay lại bài đầy đủ. Tắt cho tới khi bạn bật nó trong Cài đặt.</string>
    <string name="tour_cast_name">Nooz Cast</string>
    <string name="tour_cast_body">Bài báo được đọc lên bằng một giọng chạy trên điện thoại của bạn chứ không phải trên máy chủ. Cũng nằm trong Cài đặt; nó hỏi trước khi tải bất cứ thứ gì.</string>
    <string name="tour_clippings_name">Mẩu cắt</string>
    <string name="tour_clippings_body">Chạm vào dấu trang khi đang đọc để giữ lại một bài. Mẩu cắt giữ chúng như những mảnh báo xé ra.</string>
    <string name="tour_history_name">Ngày này trong lịch sử</string>
    <string name="tour_history_body">Một cột ngắn có ghi ngày, đặt trên các tin trong ngày, lấy từ mục “ngày này năm xưa” của chính Wikipedia. Tắt cho tới khi bạn bật.</string>
    <string name="tour_footer">Ở đây không có gì với tay tới thứ bạn không yêu cầu. Ba công tắc phía trên vẫn tắt cho tới khi chính bạn bật chúng.</string>
